menuconfig SERVICE_NETBOOT
    bool "Network Booting (Netboot via TFTP/DHCP)"
    default y
    help
      Enables the baremetal netboot service using GEM0/GEM1.

if SERVICE_NETBOOT

config NETBOOT_AUTO_FALLBACK
    bool "Automatic Fallback to Netboot on Boot Failure"
    default y
    help
      Automatically attempts to fetch and execute an image over TFTP if
      local storage media (SD card, eMMC, QSPI) does not contain a valid image.

config NETBOOT_DEFAULT_SERVER_IP
    string "Default TFTP Server IP"
    default "192.168.20.94"
    help
      Fallback IP address of the TFTP server if not supplied via CLI or DHCP next-server.

config NETBOOT_DEFAULT_FILENAME
    string "Default Boot Image Filename"
    default "boot.bin"
    help
      Filename requested from TFTP server if no argument is passed in TinyCLI.

config NETBOOT_DDR_DEST_ADDR
    hex "Destination DDR Load Address"
    default 0x80000000
    help
      Target physical memory address where the downloaded image will be staged.

endif